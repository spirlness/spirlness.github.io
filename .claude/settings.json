{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/on-edit.mjs"],
            "timeout": 120,
            "statusMessage": "on-edit check: eslint --fix + related tests"
          }
        ]
      }
    ]
  }
}
